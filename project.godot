; Open this file in Godot 4.7, then press F6/F5 to explore.
config_version=5

[application]
config/name="星灯りの約束 | Starlight"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="StarlightRPG"
config/icon="res://assets/art/spark.png"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.025,0.045,0.075,1)

[audio]
driver/enable_input=false
general/default_playback_type.web=2

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194321)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194323)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":90),Object(InputEventKey,"physical_keycode":69),Object(InputEventKey,"physical_keycode":4194309),Object(InputEventKey,"physical_keycode":32)]}
menu={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventKey,"physical_keycode":88),Object(InputEventKey,"physical_keycode":67)]}
run={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
mute={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":77)]}
